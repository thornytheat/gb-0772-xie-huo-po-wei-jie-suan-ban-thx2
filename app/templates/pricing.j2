<div class="card-heading"><h2>跨日费率分段</h2><label>实际停靠 <select id="stay-picker">{% for r in report.pricing.stays %}<option value="{{ loop.index0 }}">{{ r.berth }} · {{ local(r.start) }}</option>{% endfor %}</select></label></div>
{% for r in report.pricing.stays %}<div class="fee-path" data-fee-stop="{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %}><ol class="timeline fee-timeline">{% for s in r.segments %}<li class="{{ s.code }}"><time>{{ local(s.start) }}–{{ local(s.end)[-5:] }}</time><div><strong>{{ label[s.code] }}</strong><p>{{ s.minutes }} 分钟 · {{ yuan(s.rate_cents) }}/分</p><span class="rate-tag" title="该分钟生效的费率版本">{{ s.rate_version }}</span></div><b>{{ yuan(s.cents) }}</b></li>{% endfor %}</ol><section class="panel fee-summary"><h3>停靠核价</h3><dl><dt>泊位</dt><dd>{{ r.berth }}</dd><dt>预约</dt><dd>{{ label[r.association] }}</dd><dt>在位</dt><dd>{{ r.minutes }} 分钟</dd><dt>采用费率版本</dt><dd>{{ r.segments | map(attribute='rate_version') | unique | join('、') }}</dd><dt>应收</dt><dd>{{ yuan(r.due_cents) }}</dd></dl><p>检测行 {{ r.detections|map(attribute='line')|join(', ') }}</p></section></div>{% else %}<p>暂无可核价停靠。</p>{% endfor %}
{% if report.pricing.switch and report.pricing.switch.scenarios|length > 1 %}
<section class="panel rate-switch"><h3>费率切换应收对照</h3><p class="hint">实际应收按每个计费分钟当时生效的费率版本取价；下表为同一原件假设整窗统一按某一版本计价的对照。</p><div class="tablebox"><table><thead><tr><th>费率版本</th><th>生效时刻</th><th>基础/升级 分/分</th><th>统一计价应收</th><th>相对实际应收差额</th></tr></thead><tbody>{% for sc in report.pricing.switch.scenarios %}<tr><td><code>{{ sc.rate_version }}</code></td><td>{{ local(sc.effective_at) }}</td><td>{{ sc.base_cents }} / {{ sc.upgrade_cents }}</td><td>{{ yuan(sc.due_cents) }}</td><td class="{{ 'difference' if sc.delta_cents else '' }}">{{ yuan(sc.delta_cents) }}</td></tr>{% endfor %}</tbody></table></div><p>实际（停靠时刻适用费率）应收 <b>{{ yuan(report.pricing.switch.actual_due_cents) }}</b></p></section>
{% endif %}

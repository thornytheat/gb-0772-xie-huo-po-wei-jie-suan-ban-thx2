<h2>逐单差价</h2><div class="tablebox"><table><thead><tr><th>到达 / 泊位</th><th>采用费率版本</th><th>应收</th><th>实收</th><th>差价</th><th>回执</th><th>结论</th></tr></thead><tbody>{% set applied = {} %}{% for item in report.pricing.switch.applied_versions %}{% set _ = applied.update({item.stay: item.rate_versions|join('、')}) %}{% endfor %}{% for row in report.settlement.lines %}<tr><td>{{ local(row.arrival) }} · {{ row.berth }}</td><td><code>{{ applied.get(row.stay, '—') }}</code></td><td>{{ yuan(row.due_cents) }}</td><td>{{ yuan(row.paid_cents) }}</td><td class="{{ 'difference' if row.difference_cents else '' }}">{{ yuan(row.difference_cents) }}</td><td>{% for r in row.receipts %}{{ r.fields.receipt }} · 第 {{ r.line }} 行{% if not loop.last %} / {% endif %}{% else %}—{% endfor %}</td><td>{{ label[row.code] }}</td></tr>{% else %}<tr><td colspan="7">没有可结算停靠。</td></tr>{% endfor %}</tbody></table></div>
{% if report.pricing.switch and report.pricing.switch.scenarios|length > 1 %}
<section class="panel rate-switch"><h3>费率切换前后应收差额</h3><p class="hint">跨切换点的停靠按各计费分钟当时生效的费率取价，已签收历史账不按新费率倒改；下表为同一份原件在各版本下统一计价的对照。</p><div class="tablebox"><table><thead><tr><th>费率版本</th><th>生效时刻</th><th>基础价 分/分</th><th>升级价 分/分</th><th>统一计价应收</th><th>相对实际应收</th></tr></thead><tbody>{% for sc in report.pricing.switch.scenarios %}<tr><td><code>{{ sc.rate_version }}</code></td><td>{{ local(sc.effective_at) }}</td><td>{{ sc.base_cents }}</td><td>{{ sc.upgrade_cents }}</td><td>{{ yuan(sc.due_cents) }}</td><td class="{{ 'difference' if sc.delta_cents else '' }}">{{ yuan(sc.delta_cents) }}</td></tr>{% endfor %}</tbody></table></div><dl class="switch-total"><dt>实际应收（停靠时刻适用费率）</dt><dd>{{ yuan(report.pricing.switch.actual_due_cents) }}</dd><dt>旧版统一计价</dt><dd>{{ yuan(report.pricing.switch.scenarios[0].due_cents) }}</dd><dt>新版统一计价</dt><dd>{{ yuan(report.pricing.switch.scenarios[-1].due_cents) }}</dd><dt>新版 − 旧版差额</dt><dd class="difference">{{ yuan(report.pricing.switch.scenarios[-1].due_cents - report.pricing.switch.scenarios[0].due_cents) }}</dd></dl></section>
{% endif %}
<section class="panel exceptions"><h3>游离实收</h3>{% for row in report.settlement.orphans %}<p>回执 {{ row.fields.receipt }} · 第 {{ row.line }} 行 · {{ yuan(row.cents) }}</p>{% else %}<p>无游离回执。</p>{% endfor %}</section>{% if report.settlement.isolated %}{% set issues=report.settlement.isolated %}{% include 'issues.j2' %}{% endif %}
